MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/myportfolio
# Optional complete fallback URI.
MONGODB_DIRECT_URI=
# Optional SRV-DNS fallback. Copy the Atlas shard hosts and replica set;
# credentials remain sourced from MONGODB_URI.
MONGODB_SEED_HOSTS=
MONGODB_REPLICA_SET=
GUESTBOOK_ADMIN_KEY=change-this-to-a-long-random-secret
